{
  "name": "Isolated Playground",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig"
      ]
    }
  },

  // Deliberately NOT mounting ~/.ssh or ~/.gitconfig-with-credentials,
  // and NOT forwarding a GH token. Container can read local git history
  // but has no way to authenticate to the remote. Commit/push happens
  // from the host, outside this container.

  "forwardPorts": [],
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && echo 'Container ready!'",

  "remoteUser": "vscode"
}
